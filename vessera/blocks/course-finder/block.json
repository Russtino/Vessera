{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "vessera/course-finder",
	"version": "1.0.0",
	"title": "Course Finder",
	"category": "vessera",
	"icon": "book-alt",
	"description": "A searchable table of all courses, filterable by department and program.",
	"keywords": [ "courses", "search", "filter", "catalog", "course list" ],
	"textdomain": "vessera",
	"attributes": {
		"showSearch": { "type": "boolean", "default": true },
		"showDepartmentFilter": { "type": "boolean", "default": true },
		"showProgramFilter": { "type": "boolean", "default": true },
		"showDepartmentColumn": { "type": "boolean", "default": true },
		"linkCourses": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true }
	},
	"editorScript": "vessera-blocks",
	"style": "vessera-blocks",
	"viewScript": "vessera-program-finder-view",
	"render": "file:./render.php"
}
